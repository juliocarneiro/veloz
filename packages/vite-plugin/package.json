{
  "name": "vite-plugin-veloz",
  "version": "0.1.2",
  "description": "Vite plugin for Veloz: JSX setup and SSR module resolution.",
  "keywords": [
    "vite",
    "vite-plugin",
    "veloz",
    "velozjs",
    "jsx",
    "ssr"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Julio Carneiro (https://juliocarneiro.dev)",
  "license": "MIT",
  "homepage": "https://veloz-site.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliocarneiro/veloz.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/juliocarneiro/veloz/issues"
  }
}
