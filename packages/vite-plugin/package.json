{
  "name": "vite-plugin-veloz",
  "version": "0.1.0",
  "description": "Vite plugin for Veloz.js - JSX transform and HMR",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "license": "MIT"
}
