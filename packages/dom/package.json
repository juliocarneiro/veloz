{
  "name": "@velozjs/dom",
  "version": "0.1.2",
  "description": "Veloz DOM renderer: JSX runtime, control flow, hydration and built-in XSS protection.",
  "keywords": [
    "veloz",
    "velozjs",
    "signals",
    "reactive",
    "fine-grained",
    "jsx",
    "dom",
    "renderer",
    "hydration",
    "framework"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "jsx-runtime": [
        "./dist/jsx-runtime.d.ts"
      ],
      "jsx-dev-runtime": [
        "./dist/jsx-dev-runtime.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@velozjs/core": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Julio Carneiro (https://juliocarneiro.dev)",
  "license": "MIT",
  "homepage": "https://veloz-site.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliocarneiro/veloz.git",
    "directory": "packages/dom"
  },
  "bugs": {
    "url": "https://github.com/juliocarneiro/veloz/issues"
  }
}
