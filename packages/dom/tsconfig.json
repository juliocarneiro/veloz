{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "jsxImportSource": "@velozjs/dom",
    "paths": {
      "@velozjs/dom/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@velozjs/dom/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"],
  "exclude": ["dist"]
}
