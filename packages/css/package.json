{
  "name": "@veloz/css",
  "version": "0.1.0",
  "description": "CSS-in-JS module for Veloz.js with auto-scoping",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@veloz/dom": "workspace:*"
  },
  "peerDependencies": {
    "@veloz/core": "workspace:*"
  },
  "sideEffects": false,
  "license": "MIT"
}
