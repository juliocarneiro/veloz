{
  "name": "@velozjs/core",
  "version": "0.1.1",
  "description": "Veloz reactive core: signals, memos, effects and ownership. No DOM required.",
  "keywords": [
    "veloz",
    "velozjs",
    "signals",
    "reactive",
    "fine-grained",
    "jsx",
    "reactivity",
    "state"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Julio Carneiro (https://juliocarneiro.dev)",
  "license": "MIT",
  "homepage": "https://veloz-site.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliocarneiro/veloz.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/juliocarneiro/veloz/issues"
  }
}
